{
  "_comment": "Merge this into ~/.claude/settings.json - do not replace the file. If you already have a SessionStart entry, add another object to its array rather than overwriting the existing one; multiple hooks run fine side by side. The session-name hook and statusLine are optional and independent of the vault hook; drop whichever you don't want. If you already have a statusLine, keep yours or combine the two scripts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/load-vault-index.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-name.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "padding": 0
  }
}
