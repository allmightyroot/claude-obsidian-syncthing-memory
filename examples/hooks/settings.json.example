{
  "_comment": "Merge this into ~/.claude/settings.json - do not replace the file. If you already have a SessionStart entry, add another object to its array rather than overwriting the existing one; multiple hooks run fine side by side. For optional session names and a status line, see claude-tweaks (linked from the README).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/load-vault-index.sh"
          }
        ]
      }
    ]
  }
}
